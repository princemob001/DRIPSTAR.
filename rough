  <script>
    let activeProduct = {};

    function initPage() { updateCartUI(); }

    function openPopup(name, front, back, price) {
      activeProduct = { name, price, front };
      document.getElementById('popup-name').innerText = name;
      document.getElementById('popup-price').innerText = `$${price}`;
      document.getElementById('popup-img-front').src = front;
      document.getElementById('popup-img-back').src = back;
      document.getElementById('overlay').style.display = 'block';
      document.getElementById('product-popup').style.display = 'block';
    }

    function handlePopupAdd() {
      const size = document.getElementById('pop-size').value;
      const qty = document.getElementById('pop-qty').value;
      addToCart(activeProduct.name, size, activeProduct.price, qty, null);
      closePopup();
    }

    function addToCart(product, size, price, quantity, button) {
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      cart.push({ product, size, price, quantity });
      localStorage.setItem("cart", JSON.stringify(cart));
      updateCartUI();
      if(button) {
          const conf = button.nextElementSibling;
          conf.innerHTML = "✅ Added!";
          conf.style.opacity = "1";
          setTimeout(() => conf.style.opacity = "0", 2000);
      }
    }

    function updateCartUI() {
      const cart = JSON.parse(localStorage.getItem("cart")) || [];
      document.getElementById('cart-count').innerText = cart.length;
      const totalPrice = cart.reduce((acc, i) => acc + (parseFloat(i.price) * parseInt(i.quantity)), 0);
      const fill = Math.min((totalPrice / 200) * 100, 100);
      document.getElementById('shipping-progress-fill').style.width = fill + "%";
      document.getElementById('shipping-text').innerText = totalPrice >= 200 ? 
        "🎉 FREE SHIPPING UNLOCKED!" : `You're $${(200 - totalPrice).toFixed(2)} away from FREE SHIPPING!`;
    }

    function toggleWish(n, i, p, b) {
      b.classList.toggle('active');
      // Logic for saving to wishlist storage can go here
    }

    function closePopup() { document.getElementById('overlay').style.display='none'; document.getElementById('product-popup').style.display='none'; }
  </script>
