  <div class="container">
    <h1>Your Shopping Cart</h1>
    <table id="cartTable">
      <thead>
        <tr>
          <th>Product</th>
          <th>Size</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Subtotal</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>

    <div class="total" id="cartTotal">Total: $0</div>
    <button class="checkout-btn" onclick="renderCart()">Refresh Cart</button>
    </div>

