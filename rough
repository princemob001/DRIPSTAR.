  <script>
    let activeProduct = {};

    function initPage() {
      updateCartCount();
      startTimer();
      pickRandomBestSeller();
    }

    function pickRandomBestSeller() {
      const badges = document.querySelectorAll('.best-seller-badge');
      const now = new Date().getTime();
      const expirationTime = 27 * 60 * 60 * 1000; // 27 hours in ms
      
      let storedData = JSON.parse(localStorage.getItem('bestSellerData'));

      // If no data OR 27 hours have passed, pick a new random product
      if (!storedData || (now - storedData.timestamp) > expirationTime) {
        const randomIndex = Math.floor(Math.random() * badges.length);
        storedData = {
            index: randomIndex,
            timestamp: now
        };
        localStorage.setItem('bestSellerData', JSON.stringify(storedData));
      }

      // Hide all, then show the stored one
      badges.forEach(b => b.style.display = 'none');
      badges[storedData.index].style.display = 'block';
    }

    function startTimer() {
      let time = 18000;
      setInterval(() => {
        let h = Math.floor(time / 3600);
        let m = Math.floor((time % 3600) / 60);
        let s = time % 60;
        document.getElementById('countdown').innerText = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        if (time > 0) time--;
      }, 1000);
    }

    function triggerCartEffects() {
      document.getElementById('cart-sound').play();
      const bubble = document.getElementById('cart-bubble');
      bubble.classList.remove('shake');
      void bubble.offsetWidth;
      bubble.classList.add('shake');
    }

    function updateCartCount() {
      const cart = JSON.parse(localStorage.getItem("cart")) || [];
      const totalItems = cart.reduce((acc, item) => acc + parseInt(item.quantity), 0);
      document.getElementById('cart-count').innerText = totalItems;
    }

    function openPopup(name, front, back, price) {
      activeProduct = { name, price };
      document.getElementById('popup-name').innerText = name;
      document.getElementById('popup-price').innerText = `$${price}`;
      document.getElementById('popup-img-front').src = front;
      document.getElementById('popup-img-back').src = back;
      document.getElementById('overlay').style.display = 'block';
      document.getElementById('product-popup').style.display = 'block';
    }

    function closePopup() {
      document.getElementById('overlay').style.display = 'none';
      document.getElementById('product-popup').style.display = 'none';
    }

    function handlePopupAdd() {
      const size = document.getElementById('popup-size').value;
      const qty = parseInt(document.getElementById('popup-qty').value);
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      cart.push({ product: activeProduct.name, size: size, price: activeProduct.price, quantity: qty });
      localStorage.setItem("cart", JSON.stringify(cart));
      triggerCartEffects();
      updateCartCount();
      closePopup();
    }

    function addToCart(product, size, price, quantity, button) {
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      cart.push({ product, size, price, quantity });
      localStorage.setItem("cart", JSON.stringify(cart));
      triggerCartEffects();
      updateCartCount();
      const conf = button.nextElementSibling;
      conf.innerHTML = `✅ Added!`; conf.style.opacity = "1";
      setTimeout(() => { conf.style.opacity = "0"; }, 2000);
    }
  </script>
</body>
